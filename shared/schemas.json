  "EngineHealth": {
    "description": "Engine health status.",
    "properties": {
      "status": {
        "default": "ok",
        "title": "Status",
        "type": "string"
      },
      "version": {
        "title": "Version",
        "type": "string"
      },
      "engine_ok": {
        "default": true,
        "title": "Engine Ok",
        "type": "boolean"
      }
    },
    "required": [
      "version"
    ],
    "title": "EngineHealth",
    "type": "object"
  },
  "EngineInfo": {
    "description": "Engine metadata and runtime parameters.",
    "properties": {
      "name": {
        "default": "Integrity Intelligence Engine",
        "title": "Name",
        "type": "string"
      },
      "version": {
        "title": "Version",
        "type": "string"
      },
      "status": {
        "default": "active",
        "title": "Status",
        "type": "string"
      },
      "match_threshold": {
        "title": "Match Threshold",
        "type": "number"
      },
      "model_version": {
        "title": "Model Version",
        "type": "string"
      }
    },
    "required": [
      "version",
      "match_threshold",
      "model_version"
    ],
    "title": "EngineInfo",
    "type": "object"
  },
  "IntegrityScore": {
    "$defs": {
      "Signal": {
        "description": "An integrity signal raised against an institution.",
        "properties": {
          "signal_id": {
            "title": "Signal Id",
            "type": "string"
          },
          "institution_id": {
            "title": "Institution Id",
            "type": "string"
          },
          "signal_name": {
            "title": "Signal Name",
            "type": "string"
          },
          "severity": {
            "default": "warning",
            "enum": [
              "error",
              "warning",
              "review",
              "info"
            ],
            "title": "Severity",
            "type": "string"
          },
          "score": {
            "default": 0.0,
            "title": "Score",
            "type": "number"
          },
          "evidence": {
            "additionalProperties": true,
            "title": "Evidence",
            "type": "object"
          },
          "description": {
            "default": "",
            "title": "Description",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          }
        },
        "required": [
          "institution_id",
          "signal_name"
        ],
        "title": "Signal",
        "type": "object"
      }
    },
    "description": "Institution integrity score with associated signals and risk assessment.",
    "properties": {
      "institution_id": {
        "title": "Institution Id",
        "type": "string"
      },
      "score": {
        "maximum": 100.0,
        "minimum": 0.0,
        "title": "Score",
        "type": "number"
      },
      "risk_level": {
        "default": "low",
        "enum": [
          "low",
          "medium",
          "high",
          "critical"
        ],
        "title": "Risk Level",
        "type": "string"
      },
      "generated_at": {
        "format": "date-time",
        "title": "Generated At",
        "type": "string"
      },
      "signals": {
        "items": {
          "$ref": "#/$defs/Signal"
        },
        "title": "Signals",
        "type": "array"
      }
    },
    "required": [
      "institution_id",
      "score"
    ],
    "title": "IntegrityScore",
    "type": "object"
  },
  "MatchCase": {
    "description": "Represents a potential duplicate between institutions.",
    "properties": {
      "case_id": {
        "title": "Case Id",
        "type": "string"
      },
      "institution_a": {
        "title": "Institution A",
        "type": "string"
      },
      "institution_b": {
        "title": "Institution B",
        "type": "string"
      },
      "student_a_id": {
        "title": "Student A Id",
        "type": "string"
      },
      "student_b_id": {
        "title": "Student B Id",
        "type": "string"
      },
      "similarity_score": {
        "maximum": 1.0,
        "minimum": 0.0,
        "title": "Similarity Score",
        "type": "number"
      },
      "confidence": {
        "maximum": 1.0,
        "minimum": 0.0,
        "title": "Confidence",
        "type": "number"
      },
      "matched_fields": {
        "items": {
          "type": "string"
        },
        "title": "Matched Fields",
        "type": "array"
      },
      "status": {
        "default": "open",
        "enum": [
          "open",
          "confirmed",
          "dismissed",
          "correction_requested"
        ],
        "title": "Status",
        "type": "string"
      },
      "created_at": {
        "format": "date-time",
        "title": "Created At",
        "type": "string"
      }
    },
    "required": [
      "institution_a",
      "institution_b",
      "student_a_id",
      "student_b_id",
      "similarity_score",
      "confidence"
    ],
    "title": "MatchCase",
    "type": "object"
  },
  "Signal": {
    "description": "An integrity signal raised against an institution.",
    "properties": {
      "signal_id": {
        "title": "Signal Id",
        "type": "string"
      },
      "institution_id": {
        "title": "Institution Id",
        "type": "string"
      },
      "signal_name": {
        "title": "Signal Name",
        "type": "string"
      },
      "severity": {
        "default": "warning",
        "enum": [
          "error",
          "warning",
          "review",
          "info"
        ],
        "title": "Severity",
        "type": "string"
      },
      "score": {
        "default": 0.0,
        "title": "Score",
        "type": "number"
      },
      "evidence": {
        "additionalProperties": true,
        "title": "Evidence",
        "type": "object"
      },
      "description": {
        "default": "",
        "title": "Description",
        "type": "string"
      },
      "created_at": {
        "format": "date-time",
        "title": "Created At",
        "type": "string"
      }
    },
    "required": [
      "institution_id",
      "signal_name"
    ],
    "title": "Signal",
    "type": "object"
  },
  "SignalsRequest": {
    "additionalProperties": true,
    "description": "Request payload for POST /engine/signals.",
    "properties": {
      "institution_id": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Institution Id"
      },
      "admissions": {
        "items": {
          "additionalProperties": true,
          "type": "object"
        },
        "title": "Admissions",
        "type": "array"
      },
      "records": {
        "items": {
          "additionalProperties": true,
          "type": "object"
        },
        "title": "Records",
        "type": "array"
      },
      "seat_pools": {
        "items": {
          "additionalProperties": true,
          "type": "object"
        },
        "title": "Seat Pools",
        "type": "array"
      },
      "historical_stats": {
        "items": {
          "additionalProperties": true,
          "type": "object"
        },
        "title": "Historical Stats",
        "type": "array"
      },
      "rules_config": {
        "additionalProperties": true,
        "title": "Rules Config",
        "type": "object"
      }
    },
    "title": "SignalsRequest",
    "type": "object"
  }
}
