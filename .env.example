# APAAR Integrity Platform: master environment template.
# Copy the relevant block into backend/.env, frontend/.env or bot/.env.
# Placeholders only. Never commit real secrets.

# ---------------------------------------------------------------------------
# Backend (backend/.env)
# ---------------------------------------------------------------------------
# Supabase project URL
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase service role key (server only, never ship to the browser)
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Supabase JWT secret used to verify HS256 access tokens
SUPABASE_JWT_SECRET=replace-with-jwt-secret
# Postgres connection string; use the Supabase session pooler URI (Connect > Session pooler)
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-region.pooler.supabase.com:5432/postgres
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
# true: demo auth via X-Demo-Role / X-Demo-Institution headers; false: Supabase access tokens
MOCK_MODE=true
# Domains served from Postgres (comma-separated): institutions,seat_ledger,batches,admissions,review_cases,audit
REAL_DOMAINS=
# Largest accepted upload in megabytes (larger files get 413)
MAX_UPLOAD_MB=5
# Most data rows accepted in one upload (more get 422)
MAX_UPLOAD_ROWS=20000
# Admissions dated after this day raise ADMISSION_AFTER_CUTOFF
ADMISSION_CUTOFF_DATE=2026-09-30
# Rows sharing one contact hash before SHARED_CONTACT_CLUSTER is raised
SHARED_CONTACT_THRESHOLD=5
# HMAC key for Blind Match Bloom-filter encodings
BLIND_MATCH_SECRET=replace-with-random-32-byte-hex
# HMAC key for per-verifier student pseudonyms and contact hashes (required for real batches)
PSEUDONYM_SECRET=replace-with-random-32-byte-hex
# Ed25519 private key seed (hex) for signing student credentials
CREDENTIAL_SIGNING_KEY=replace-with-ed25519-seed-hex
# Shared secret Telegram sends in X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=replace-with-webhook-secret

# ---------------------------------------------------------------------------
# Frontend (frontend/.env)
# ---------------------------------------------------------------------------
# Supabase project URL exposed to the browser
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase anon (public) key
VITE_SUPABASE_ANON_KEY=replace-with-anon-key
# Backend base URL
VITE_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Bot (bot/.env)
# ---------------------------------------------------------------------------
# Token issued by BotFather
TELEGRAM_BOT_TOKEN=replace-with-bot-token
# Backend base URL the bot calls
API_URL=http://localhost:8000
# Must match the backend TELEGRAM_WEBHOOK_SECRET
TELEGRAM_WEBHOOK_SECRET=replace-with-webhook-secret
